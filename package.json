{
  "name": "metrovivo-cdmx",
  "version": "1.0.0",
  "private": true,
  "description": "MetroVivo CDMX — Mapa 3D ciudadano y sin fines de lucro del Metro CDMX",
  "scripts": {
    "dev": "node --no-warnings ./node_modules/next/dist/bin/next dev",
